# =============================================================================
# extractor — environment template
#
# Copy to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored — never commit real credentials.
# Every variable below is REQUIRED: docker-compose.yaml has no fallback
# values, so a missing key fails the build/up with a clear error.
# =============================================================================

# --- Ollama models (run on your local GPU) -----------------------------------

# LLM used for keep/drop page classification and Firecrawl /extract.
# Must be a valid Ollama tag; pulled automatically by the ollama-pull service.
# qwen2.5:14b-instruct-q4_K_M ≈ 9 GB, fits comfortably in 24 GB VRAM.
LLM_MODEL=qwen2.5:14b-instruct-q4_K_M

# Embedding model for corpus chunks. bge-large is BAAI/bge-large-en-v1.5
# (1024-dim vectors, 671 MB) in the Ollama registry.
EMBED_MODEL=bge-large

# Fixed seed for deterministic LLM inference. Combined with temperature=0 and
# top_k=1 (hardcoded in pipeline/config.py) this keeps runs reproducible.
LLM_SEED=1234

# --- Firecrawl internal services ----------------------------------------------

# Credentials for nuq-postgres, Firecrawl's internal job-queue database.
# Internal-only service (never published to the host), but still required.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<insert_password_here>
POSTGRES_DB=postgres

# Firecrawl worker tuning. Defaults match upstream self-host recommendations;
# raise if the host has spare CPU/RAM, lower to be gentler on target sites.
NUM_WORKERS_PER_QUEUE=8        # parallel scrape jobs per queue worker
CRAWL_CONCURRENT_REQUESTS=10   # max concurrent Playwright pages
MAX_CONCURRENT_JOBS=5          # max concurrent jobs processed at once

# --- MongoDB (corpus store) ---------------------------------------------------

# Root credentials for the corpus database. Internal-only; also used for the
# app's MONGO_URI connection string built inside docker-compose.yaml.
MONGO_USER=extractor
MONGO_PASSWORD=<insert_password_here>
MONGO_DB=extractor

# --- App / UI -----------------------------------------------------------------

# The ONLY host-published port in the stack: web UI + JSON API.
# Choose a port that is free on the host (8080 and 8088 are commonly taken).
APP_PORT=8090

# --- Pipeline tuning ----------------------------------------------------------

# Minimum word count for a scraped page to reach the LLM classifier. Keep it
# low — the LLM judges quality; this only skips near-empty pages. ~30 works
# for business sites with short factual pages (hours, menus, addresses);
# raise (~150+) for docs-heavy sites to save classify calls.
MIN_WORDS=30

# Comma-separated substrings: any child sitemap URL containing one is skipped
# during sitemap-fallback discovery — drops entire product/brand catalogs
# before scraping (BigCommerce xmlsitemap.php?type=products, *product-sitemap*).
# Clear to keep product pages in the corpus.
SITEMAP_SKIP_PATTERNS=type=products,product-sitemap,products-sitemap

# Optional regex applied to every discovered URL path at triage — rejects
# matching URLs pre-scrape as "user-excluded". For sites whose product URLs
# have no sitemap-type signal (Shopify /products/, Woo /product/), e.g.:
#   EXCLUDE_PATH_REGEX=/(products?|collections?)(/|$)
# Empty = disabled.
EXCLUDE_PATH_REGEX=
